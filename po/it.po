# Preferences - Panel visibility
# ——————————————————————————————
#: nautilus_my_computer/main.py
msgid "Panel visibility"
msgstr "Visibilità del pannello"

#: nautilus_my_computer/main.py
msgid ""
"Choose how each group appears. Visible: shows the group as a normal "
"separated section. Merged: folds the group into the On this Computer group. "
"Hidden: hides the group entirely."
msgstr ""
"Scegli come appare ogni gruppo. Visibile: mostra il gruppo come una normale "
"sezione separata. Integrato: unisce il gruppo al gruppo In questo computer. "
"Nascosto: nasconde completamente il gruppo."

#: nautilus_my_computer/main.py
msgid "Visible"
msgstr "Visibile"

#: nautilus_my_computer/main.py
msgid "Merged"
msgstr "Integrato"

#: nautilus_my_computer/main.py
msgid "Hidden"
msgstr "Nascosto"

