# ——————————————————————————————
# Preferences - Panel visibility
# ——————————————————————————————
msgid "Panel visibility"
msgstr "Ορατότητα καταχωρίσεων"

msgid ""
"Choose how each group appears. Visible: shows the group as a normal "
"separated section. Merged: folds the group into the On this Computer group. "
"Hidden: hides the group entirely."
msgstr ""
"Επιλέξτε την ορατότητα του κάθε γκρούπ. Ορατό: προβολή διαχωρισμένου γκρούπ. "
"Συγχωνευμένο: συγχωνεύει το γκρούπ με το γκρούπ Ο Υπολογιστής μου. Κρυμμένο: "
"κρύβει το γκρούπ."

msgid "Visible"
msgstr "Ορατό"

msgid "Merged"
msgstr "Συγχωνευμένο"

msgid "Hidden"
msgstr "Κρυμμένο"

# ——————————————————————————————
# Preferences - System
# ——————————————————————————————
msgid "Show system partitions"
msgstr "Προβολή διαμερισμάτων συστήματος"

msgid "Include boot and EFI partitions in the System group"
msgstr "Προσθήκη διαμερισμάτων boot και EFI στο γκρούπ Σύστημα"

# ——————————————————————————————
# Preferences - Sidebar visibility
# ——————————————————————————————
msgid "Sidebar visibility"
msgstr "Ορατότητα πλευρικής μπάρας"

msgid "Choose which locations appear on the sidebar."
msgstr "Επιλέξτε ποιοί προορισμοί να είναι ορατοί στη πλευρική μπάρα."

